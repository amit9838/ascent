# Firebase web config. Copy to .env.local and fill from:
# Firebase console → Project settings → Your apps → Web app → SDK setup.
#
# These values are PUBLIC by design (they ship in the browser bundle and
# identify the project, not grant access). Real protection comes from
# Firestore Security Rules (firestore.rules) + Auth authorized domains.
#
# The app runs 100% local/offline when these are unset — cloud UI stays hidden.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google reCAPTCHA v3 site key to enable Firebase App Check
# (abuse protection). Also enable enforcement in Firebase console.
VITE_RECAPTCHA_V3_SITE_KEY=

# Set to 1 in .env.local to point Auth+Firestore at the local emulator
# suite (npx firebase-tools emulators:start --only auth,firestore) so
# development never touches production data.
VITE_USE_EMULATORS=
