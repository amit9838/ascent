rules_version = '2';

// Ascent Firestore rules — deploy by pasting into:
// Firebase console → Firestore Database → Rules.
//
// Model: users/{uid}/solves/{id}       my solves (owner only)
//        users/{uid}/notes/{id}        my private notes (owner only)
//        users/{uid}/rewardEvents/{id} my reward events (owner only)
//        users/{uid}/settings/preferences my targets (owner only)
//        users/{uid}/invites/{from}    invites I received
//        users/{uid}/sent/{to}         invites I sent (status mirror)
//        users/{uid}/connections/{p}   my leaderboard connections (identity only)
//        users/{uid}/sharedWithMe/{n}  notes shared with me (discovery inbox)
//        sharedNotes/{noteId}          collaborative notes: owner + members
//                                      may read; owner manages members;
//                                      members may edit title/body only
//        profiles/{uid}                public stats (readable only when shared)
//        emails/{sha256(email)}        email -> uid index for invites
//
// Default deny: anything not matched above is inaccessible.
//
// Delete-account contract (auth.js deleteAccountAndCloudData wipes, in
// order, before the auth user is removed): every doc under
// users/{uid}/{solves,notes,rewardEvents,invites,sent,connections,
// sharedWithMe}, the users/{uid}/settings/preferences doc, profiles/{uid}, every
// sharedNotes/{id} with ownerUid == uid (plus each member's inbox entry,
// permitted by the owner-delete rule above), and emails/{sha256(email)}.
// Counterpart rows inside OTHER users' trees (their connections/{me} and
// sent mirrors) can't be enumerated client-side and are left to read as
// "no data yet" through the profile-gated leaderboard.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Per-record LWW sync: whole records, real fields (queryable).
      match /solves/{problemId} {
        allow read, write: if isOwner(uid);
      }

      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (!("body" in request.resource.data)
              || request.resource.data.body.size() < 12000);
      }

      match /rewardEvents/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.status in ["earned", "collected"];
      }

      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Invites I received. Created by the inviter (who must tag the
      // invite with their own uid and status "pending"); only I can
      // read or update them after that. The inviter may delete their
      // own invite (withdraw) — but only while it still exists in my
      // inbox, i.e. they can't touch it after I accept/reject.
      match /invites/{fromUid} {
        allow read: if isOwner(uid);
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "pending";
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (request.auth != null && request.auth.uid == fromUid);
      }

      // Mirror of invites I sent, so I can see pending/accepted/rejected.
      // The invitee (toUid) may update their own entry (status/name),
      // never anyone else's.
      match /sent/{toUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          || (request.auth != null && request.auth.uid == toUid
              && request.resource.data.uid == toUid);
        allow delete: if isOwner(uid);
      }

      // My leaderboard connections: identity only (name + photo). Stats
      // are read live from each peer's public profile, so peers never
      // write here — owner-only.
      match /connections/{peerUid} {
        allow read, write: if isOwner(uid);
      }

      // Notes shared with me. The owner (note creator) writes my inbox
      // entry when sharing; I read it to discover the note and delete it
      // to leave. The owner may refresh my entry's title after edits —
      // and may delete my entry when they delete their account or
      // unshare, so no ghost inbox entries survive them.
      match /sharedWithMe/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isOwner(uid)
          || (request.auth != null && request.auth.uid == resource.data.ownerUid);
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.ownerUid;
      }
    }

    // Collaborative notes. Ownership stays with the creator (ownerUid);
    // members can see and edit title/body, but only the owner manages
    // the member list or deletes the note. Sync is save-based, not
    // realtime: writers push on save, readers pull on open.
    match /sharedNotes/{noteId} {
      function isNoteOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      function isNoteMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      // Leaving: a member removes only themselves from the member list
      // (content untouched) so owners never see ghost collaborators.
      function isSelfRemoval() {
        return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() + 1 == resource.data.members.size();
      }
      allow read: if isNoteOwner() || isNoteMember();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isNoteOwner()
        || (isNoteMember()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isNoteMember() && isSelfRemoval());
      allow delete: if isNoteOwner();
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid) || resource.data.shareEnabled == true;
      allow write: if isOwner(uid);
    }

    // Email -> uid index. Keys are SHA-256 hashes so the index can't be
    // enumerated. Any signed-in user may resolve one hash (to send an
    // invite); you may only register your own email — and only you can
    // remove it (account deletion). Split from `write` because deletes
    // have no request.resource to check.
    match /emails/{emailHash} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
