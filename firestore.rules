rules_version = '2';

// Ascent Firestore rules — deploy by pasting into:
// Firebase console → Firestore Database → Rules.
//
// Model: users/{uid}/state/{doc}      private synced data (owner only)
//        users/{uid}/following/*      legacy compare-follow list (owner only)
//        users/{uid}/invites/{from}   invites I received
//        users/{uid}/sent/{to}        invites I sent (status mirror)
//        users/{uid}/connections/{p}  my leaderboard connections
//        users/{uid}/sharedWithMe/{n} notes shared with me (discovery inbox)
//        sharedNotes/{noteId}         collaborative notes: owner + members
//                                     may read; owner manages members;
//                                     members may edit title/body only
//        profiles/{uid}               public stats (readable only when shared)
//        emails/{sha256(email)}       email -> uid index for invites
//
// Default deny: anything not matched above is inaccessible.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      match /state/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /following/{targetUid} {
        allow read, write: if isOwner(uid);
      }

      // Invites I received. Created by the inviter (who must tag the
      // invite with their own uid and status "pending"); only I can
      // read or update them after that. The inviter may delete their
      // own invite (withdraw) — but only while it still exists in my
      // inbox, i.e. they can't touch it after I accept/reject.
      match /invites/{fromUid} {
        allow read: if isOwner(uid);
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "pending";
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid)
          || (request.auth != null && request.auth.uid == fromUid);
      }

      // Mirror of invites I sent, so I can see pending/accepted/rejected.
      // The invitee (toUid) may update their own entry (status/name),
      // never anyone else's.
      match /sent/{toUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          || (request.auth != null && request.auth.uid == toUid
              && request.resource.data.uid == toUid);
        allow delete: if isOwner(uid);
      }

      // My leaderboard connections. Each entry is ABOUT the peer
      // (data.uid == peerUid). The peer may create/update their own
      // entry in my list (their name + stats) and delete it (leave).
      match /connections/{peerUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          || (request.auth != null && request.auth.uid == peerUid
              && request.resource.data.uid == peerUid);
        allow delete: if isOwner(uid)
          || (request.auth != null && request.auth.uid == peerUid
              && resource.data.uid == peerUid);
      }

      // Notes shared with me. The owner (note creator) writes my inbox
      // entry when sharing; I read it to discover the note and delete it
      // to leave. The owner may refresh my entry's title after edits.
      match /sharedWithMe/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isOwner(uid)
          || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      }
    }

    // Collaborative notes. Ownership stays with the creator (ownerUid);
    // members can see and edit title/body, but only the owner manages
    // the member list or deletes the note. Sync is save-based, not
    // realtime: writers push on save, readers pull on open.
    match /sharedNotes/{noteId} {
      function isNoteOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      function isNoteMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      // Leaving: a member removes only themselves from the member list
      // (content untouched) so owners never see ghost collaborators.
      function isSelfRemoval() {
        return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() + 1 == resource.data.members.size();
      }
      allow read: if isNoteOwner() || isNoteMember();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isNoteOwner()
        || (isNoteMember()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isNoteMember() && isSelfRemoval());
      allow delete: if isNoteOwner();
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid) || resource.data.shareEnabled == true;
      allow write: if isOwner(uid);
    }

    // Email -> uid index. Keys are SHA-256 hashes so the index can't be
    // enumerated. Any signed-in user may resolve one hash (to send an
    // invite); you may only register your own email.
    match /emails/{emailHash} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
